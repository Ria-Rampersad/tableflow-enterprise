# Copy to .env and change every value marked CHANGE. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose builds DATABASE_URL from these) ---
POSTGRES_DB=tableflow
POSTGRES_USER=tableflow
POSTGRES_PASSWORD=CHANGE-local-db-password
# For running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://tableflow:CHANGE-local-db-password@localhost:5432/tableflow

# --- Security ---
JWT_SECRET_KEY=CHANGE-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# provider:key pairs for digital-ordering partners (X-API-Key header)
PARTNER_API_KEYS=uber_eats:CHANGE-uber-key,mr_d:CHANGE-mrd-key
WEBHOOK_SECRET_TRANSACTION_JUNCTION=CHANGE-tj-webhook-secret
WEBHOOK_SECRET_UBER_EATS=CHANGE-uber-webhook-secret
WEBHOOK_SECRET_MR_D=CHANGE-mrd-webhook-secret
RATE_LIMIT_PARTNER_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=20

# --- Demo data (dev only) ---
SEED_DEMO_DATA=true
SEED_DAYS=60
# Demo-user password shown on the login screen. Demo only - change or disable seeding for any shared environment.
SEED_DEMO_PASSWORD=TableFlow!2026

# --- n8n automation ---
N8N_CLIENT_SECRET=CHANGE-n8n-client-secret
ALERT_SINK_TOKEN=CHANGE-alert-sink-token
# Optional: real Slack/Teams incoming webhook instead of TableFlow's local alert sink
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Integrations ---
INTEGRATION_MODE=simulated
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.2
INCIDENT_FAILURE_THRESHOLD=3

# --- Snowflake (optional; leave blank to use the local DuckDB demo) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=TABLEFLOW_SVC
SNOWFLAKE_WAREHOUSE=TABLEFLOW_WH
SNOWFLAKE_DATABASE=TABLEFLOW_ANALYTICS
SNOWFLAKE_ROLE=TABLEFLOW_LOADER
SNOWFLAKE_PRIVATE_KEY_PATH=./keys/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
