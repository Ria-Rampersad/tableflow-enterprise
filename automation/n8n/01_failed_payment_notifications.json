          }
        ],
        [
          {
            "node": "Alert ops channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get API token": {
      "main": [
        [
          {
            "node": "Raise incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
