        "headerParameters": {
          "parameters": [
            {
              "name": "X-Alert-Token",
              "value": "={{ $env.ALERT_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: '#crm', text: $json.text }) }}",
        "options": {}
      },
      "id": "9e9bdaf2-9f12-55a1-a9b8-cff4c54ef6d9",
      "name": "Alert CRM channel",
