      "typeVersion": 4.2,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($input.first().json.items || []).map(t => ({ json: { id: t.id } }));"
      },
      "id": "3a516736-6a16-5323-99ab-f4406aea36b0",
      "name": "Split transactions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TABLEFLOW_API_URL }}/api/v1/loyalty/transactions/{{ $json.id }}/retry",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get API token').item.json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1177786b-b10b-5dea-8e86-58db61aadce3",
      "name": "Retry sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nconst ok = all.filter(i => i.json.sync_status === 'synced').length;\nreturn [{ json: { text: `:repeat: Loyalty retry: ${ok}/${all.length} transactions re-synced` } }];"
      },
      "id": "0d6cc5a9-3b2f-567f-8f6c-1d9e061c88bc",
      "name": "Summarise",
