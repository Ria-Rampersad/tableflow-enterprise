        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: 'POS forwarding failures at ' + $json.branch, severity: 'SEV2', category: 'pos', description: $json.text }) }}"
