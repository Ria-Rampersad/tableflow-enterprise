    {
      "parameters": {
        "jsCode": "const evt = $('Webhook').first().json.body ?? $('Webhook').first().json;\nconst failed = $input.first().json.failed_orders || [];\nreturn [{ json: { failed_count: failed.length, branch: evt.branch, error: evt.error,\n  text: `:warning: Simphony POS failure (${evt.event_type}) at ${evt.branch}: ${evt.error}. ${failed.length} order(s) awaiting retry.` } }];"
      },
      "id": "d12b0ea4-ca92-5852-a29c-fd26c82dd1db",
      "name": "Assess impact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "674bf2f9-4630-5c2d-9bfc-32f36317d5cb",
              "leftValue": "={{ $json.failed_count }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 3
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "55270b6f-1396-54a2-a244-d1c761b371aa",
      "name": "3+ orders stuck?",
